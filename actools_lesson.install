<?php

declare(strict_types=1);

/** Implements hook_schema(). */
function actools_lesson_schema(): array {
  return ['actools_lesson_membership' => [
    'description' => 'Derived uniqueness index. Canonical lesson order is the chapter reference field.',
    'fields' => [
      'lesson_nid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'chapter_nid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'delta' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
    ],
    'primary key' => ['lesson_nid'],
    'indexes' => ['chapter_order' => ['chapter_nid', 'delta']],
  ]];
}

/** Implements hook_install(). */
function actools_lesson_install(): void {
  \Drupal\actools_lesson\StructureInstaller::install();
  _actools_lesson_ensure_diagram_style();
}

/**
 * Adds the bounded diagram derivative for existing lesson sites.
 */
function actools_lesson_update_11001(): void {
  _actools_lesson_ensure_diagram_style();
}

/**
 * Creates a non-cropping default without changing site-owned image styles.
 */
function _actools_lesson_ensure_diagram_style(): void {
  if (\Drupal\image\Entity\ImageStyle::load('actools_lesson_diagram')) {
    return;
  }
  $style = \Drupal\image\Entity\ImageStyle::create([
    'name' => 'actools_lesson_diagram',
    'label' => 'Actools lesson diagram',
    'dependencies' => ['enforced' => ['module' => ['actools_lesson']]],
  ]);
  $style->addImageEffect([
    'id' => 'image_scale',
    'weight' => 0,
    'data' => ['width' => 1600, 'height' => 1600, 'upscale' => FALSE],
  ]);
  $style->save();
}

/** Implements hook_uninstall(). */
function actools_lesson_uninstall(): void {
  // User progress contains no content; remove it after the content guard allows uninstall.
  \Drupal::service('user.data')->delete('actools_lesson');
}
