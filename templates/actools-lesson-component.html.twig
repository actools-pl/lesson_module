{# Render arrays only. In particular, no raw author HTML or file URLs. #}
{% set rendered_heading = heading|render %}
{% set rendered_body = body|render %}
{% set rendered_figure = figure|render %}
{% set rendered_caption = caption|render %}
{% set rendered_description = description|render %}
{% set rendered_hint = hint|render %}
{% set rendered_answer = answer|render %}
{% set rendered_solution = solution|render %}
{% set rendered_source = source|render %}
{% set rendered_equation_number = equation_number|render %}
{% set rendered_prompt_figures = prompt_figures|render %}
{% set rendered_hint_figures = hint_figures|render %}
{% set rendered_answer_figures = answer_figures|render %}
{% set rendered_solution_figures = solution_figures|render %}
<section class="actools-component actools-component--{{ component_type|clean_class }}"{% if id %} id="component-{{ id }}"{% endif %}{% if rendered_heading|trim and id %} aria-labelledby="component-heading-{{ id }}"{% endif %}>
  {% if rendered_heading|trim %}<h3{% if id %} id="component-heading-{{ id }}"{% endif %}>{{ rendered_heading }}</h3>{% endif %}
  {% if component_type == 'equation' %}
    <div class="actools-equation" tabindex="0" role="region" aria-label="{{ 'Equation; scroll horizontally if needed'|t }}"{% if rendered_equation_number|trim and id %} aria-describedby="equation-number-{{ id }}"{% endif %}>
      <span class="actools-equation__math">\[{{ tex }}\]</span>
      {% if rendered_equation_number|trim %}<span class="actools-equation__number"{% if id %} id="equation-number-{{ id }}"{% endif %}>{{ rendered_equation_number }}</span>{% endif %}
    </div>
    {% if rendered_body|trim %}<div class="actools-component__body">{{ rendered_body }}</div>{% endif %}
  {% elseif component_type == 'figure' %}
    <figure class="actools-figure">
      {{ rendered_figure }}
      {% if rendered_figure|trim %}<p class="actools-figure__original-hint">{{ 'Select the diagram to view the full-resolution original.'|t }}</p>{% endif %}
      {% if rendered_caption|trim %}<figcaption>{{ rendered_caption }}</figcaption>{% endif %}
      {% if rendered_description|trim %}<details class="actools-figure__description"><summary>{{ 'Diagram description'|t }}</summary>{{ rendered_description }}</details>{% endif %}
    </figure>
    {% if rendered_body|trim %}<div class="actools-component__body">{{ rendered_body }}</div>{% endif %}
  {% elseif component_type == 'table' %}
    <div class="actools-table-scroll" tabindex="0" role="region" aria-label="{{ 'Data table; scroll horizontally if needed'|t }}">{{ rendered_body }}</div>
    <p class="actools-table-hint">{{ 'Scroll the table horizontally if it does not fit.'|t }}</p>
  {% else %}
    {% if component_type == 'result' %}<p class="actools-component__type">{{ 'Key result'|t }}</p>{% elseif component_type == 'error' %}<p class="actools-component__type">{{ 'Common error'|t }}</p>{% elseif component_type == 'example' %}<p class="actools-component__type">{{ 'Worked example'|t }}</p>{% elseif component_type == 'practice' %}<p class="actools-component__type">{{ 'Practice'|t }}</p>{% endif %}
    {% if rendered_body|trim %}<div class="actools-component__body">{{ rendered_body }}</div>{% endif %}
  {% endif %}
  {% if rendered_prompt_figures|trim %}<div class="actools-component__prompt-figures">{{ rendered_prompt_figures }}</div>{% endif %}
  {% if rendered_hint|trim or rendered_hint_figures|trim %}<details class="actools-answer actools-answer--hint"{% if expanded %} open{% endif %}><summary>{{ 'Hint'|t }}</summary><div>{{ rendered_hint }}{{ rendered_hint_figures }}</div></details>{% endif %}
  {% if rendered_answer|trim or rendered_answer_figures|trim %}<details class="actools-answer actools-answer--answer"{% if expanded %} open{% endif %}><summary>{{ 'Answer'|t }}</summary><div>{{ rendered_answer }}{{ rendered_answer_figures }}</div></details>{% endif %}
  {% if rendered_solution|trim or rendered_solution_figures|trim %}<details class="actools-answer actools-answer--solution"{% if expanded %} open{% endif %}><summary>{{ 'Solution'|t }}</summary><div>{{ rendered_solution }}{{ rendered_solution_figures }}</div></details>{% endif %}
  {% if rendered_source|trim %}<div class="actools-component__source">{{ rendered_source }}</div>{% endif %}
</section>
